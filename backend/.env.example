# Optional: enables the LLM plausibility pass in the AI Verification Layer.
# Get a free key at https://console.groq.com -> API Keys.
# Leave unset to run fully on local geo/text clustering (still works, offline-friendly).
GROQ_API_KEY=

# Secrets for auth + WhatsApp webhook verification. Change in production.
PRAHARI_SECRET=change-me-in-production
WHATSAPP_VERIFY_TOKEN=prahari-verify

# Real outbound SMS — configure EITHER Twilio OR MSG91 to actually deliver
# broadcasts to citizens' phones. Leave both empty to run simulated (demo).
# Twilio: https://console.twilio.com (Account SID, Auth Token, your number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91: https://control.msg91.com (Auth Key + approved Sender ID, e.g. PRAHRI)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# FREE instant delivery: create a bot with @BotFather, paste the token here.
# Recipient = your Telegram chat id (Comms page can auto-fetch it for you).
# TELEGRAM_CHAT_IDS: comma-separated chat ids to receive broadcasts when no
# recipient is typed in the Comms page (auto-fetches last sender if left empty).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Swap to Postgres+PostGIS in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/prahari
DATABASE_URL=sqlite:///./prahari.db
